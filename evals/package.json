{
  "name": "@gleator/lazaret-evals",
  "private": true,
  "version": "0.0.0",
  "description": "Labelled attack/benign corpus and eval runner for Lazaret.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "eval:gate": "EVAL_WRITE=1 vitest run test/eval.test.ts",
    "eval:live": "EVAL_WRITE=1 EVAL_LIVE=1 vitest run test/eval.test.ts",
    "eval:memory": "EVAL_WRITE=1 vitest run test/memory.test.ts",
    "eval:memory:live": "EVAL_WRITE=1 EVAL_LIVE=1 vitest run test/memory.test.ts"
  },
  "dependencies": {
    "@gleator/lazaret": "*",
    "@gleator/tidewater-lazaret": "*",
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22.15.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
