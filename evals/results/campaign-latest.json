  "rules": [
    {
      "id": "mem-1",
      "status": "block",
      "category": "mass_assignment",
      "description": "Profile update on /api/me tries to set a privileged role field, which the profile route should never accept.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "eq",
            "value": "/api/me",
            "ci": true
          },
          {
            "field": "json:role",
            "op": "exists"
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
    {
      "id": "mem-2",
      "status": "flag",
      "category": "path_traversal",
      "description": "Attachment filename contains a parent-directory traversal sequence.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "endsWith",
            "value": "/attachments",
            "ci": true
          },
          {
            "field": "json:filename",
            "op": "contains",
            "value": "../"
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 1,
      "liveFalsePositives": 0,
      "reason": "1 confirmed live hits, no false positives"
    },
    {
      "id": "mem-3",
      "status": "block",
      "category": "nosql_injection",
      "description": "Login request body contains a MongoDB-style $ne operator object instead of a plain credential string.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "eq",
            "value": "/api/login",
            "ci": true
          },
          {
            "field": "body",
            "op": "matches",
            "value": "\\{\\s*\"\\$(ne|gt|gte|lt|lte|regex|where|in|nin)\"",
            "ci": true
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
