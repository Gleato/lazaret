  "rules": [
    {
      "id": "mem-1",
      "status": "block",
      "category": "mass_assignment",
      "description": "Profile update on /api/me that sets the privileged role field, which the route should never accept from clients.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "eq",
            "value": "/api/me",
            "ci": true
          },
          {
            "field": "json:role",
            "op": "exists"
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
    {
      "id": "mem-2",
      "status": "flag",
      "category": "path_traversal",
      "description": "Attachment upload whose filename contains parent-directory traversal sequences.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "endsWith",
            "value": "/attachments",
            "ci": true
          },
          {
            "field": "json:filename",
            "op": "contains",
            "value": "../"
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 1,
      "liveFalsePositives": 0,
      "reason": "1 confirmed live hits, no false positives"
    },
    {
      "id": "mem-3",
      "status": "block",
      "category": "nosql_injection",
      "description": "Login request where the email or password is a MongoDB-style operator object such as $ne.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "eq",
            "value": "/api/login",
            "ci": true
          },
          {
            "field": "body",
            "op": "matches",
            "value": "\\{\\s*\"\\$(ne|gt|gte|lt|lte|regex|in|nin|where|exists)\"",
            "ci": true
          }
        ]
