  "rules": [
    {
      "id": "mem-1",
      "status": "block",
      "category": "mass_assignment",
      "description": "Blocks profile updates that try to set the account's role to admin.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "eq",
            "value": "/api/me"
          },
          {
            "field": "json:role",
            "op": "eq",
            "value": "admin",
            "ci": true
          }
        ]
      },
      "support": 2,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
    {
      "id": "mem-2",
      "status": "block",
      "category": "sqli",
      "description": "Blocks writes whose body carries a UNION SELECT, the ' or '1'='1 tautology, or a stacked DROP TABLE.",
      "when": {
        "all": [
          {
            "field": "body",
            "op": "matches",
            "value": "\\bunion\\b.+\\bselect\\b|' or '1'='1|;\\s*drop\\s+table",
            "ci": true
          }
        ]
      },
      "support": 3,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
    {
      "id": "mem-3",
      "status": "block",
      "category": "fraud",
      "description": "Blocks account credits of $100 or more, which no support policy issues in one go.",
      "when": {
        "all": [
          {
            "field": "path",
            "op": "matches",
            "value": "^/api/accounts/[^/]+/credits$"
          },
          {
            "field": "json:amount_cents",
            "op": "gte",
            "value": 10000
          }
        ]
      },
      "support": 3,
      "liveTruePositives": 2,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    },
    {
      "id": "mem-4",
      "status": "block",
      "category": "xss",
      "description": "Blocks writes whose body carries a script tag, an onerror handler or a javascript: URL.",
      "when": {
        "all": [
          {
            "field": "body",
            "op": "matches",
            "value": "<script|onerror=|javascript:",
            "ci": true
          }
        ]
      },
      "support": 4,
      "liveTruePositives": 3,
      "liveFalsePositives": 0,
      "reason": "2 confirmed live hits, no false positives"
    }
  ],
