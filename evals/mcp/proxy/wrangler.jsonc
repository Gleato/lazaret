// lazaret-mcp. Local only: no routes, no workers.dev, no deploy script.
// MCP_REVIEWER is scripted:allow, scripted:drop or scripted:hold (no paid model calls).
// HOST_SECRET is the host's credential for PUT /host/task (step 5): a local dev value.
{
  "name": "lazaret-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "MCP_LEDGER", "class_name": "McpLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpLedger"] }],
  "vars": {
    "UPSTREAM_MCP_URL": "http://127.0.0.1:55421/mcp?features=database",
    "MCP_REVIEWER": "scripted:allow",
    "LAZARET_SIGNING_SECRET": "mcp-signing-secret-0123456789",
    "HOST_SECRET": "mcp-host-secret-local"
  }
}
