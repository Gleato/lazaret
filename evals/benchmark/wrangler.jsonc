// The AgentDojo bench Worker. Local only: no routes, no workers.dev, no deploy script.
{
  "name": "lazaret-bench",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "BENCH_LEDGER", "class_name": "BenchLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BenchLedger"] }],
  "vars": { "LAZARET_SIGNING_SECRET": "bench-signing-secret-0123456789" }
}
