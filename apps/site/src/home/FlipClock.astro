---
// The header's split-flap clock (boards 2 and 3): how long the Lazaret demo has been
// live, counting up from LIVE_SINCE (src/lib/flip-clock.ts). It checks the demo's
// status once on load; if the demo can't be reached it says so and stops counting,
// rather than show an uptime that isn't true.
import { DEMO_ORIGIN } from "../lib/demo-client";
import { elapsedSince, elapsedWords, flapDigits, LIVE_SINCE } from "../lib/flip-clock";

// Rendered with the build time so there's no empty flash; the script corrects it on load.
const atBuild = elapsedSince(LIVE_SINCE, Date.now());
const digits = flapDigits(atBuild);
const groups = [
  { label: "Days", from: 0, to: 3 },
  { label: "Hrs", from: 3, to: 5 },
  { label: "Mins", from: 5, to: 7 },
  { label: "Secs", from: 7, to: 9 },
];
---

<a class="clock on-desk" href={DEMO_ORIGIN} data-clock data-since={LIVE_SINCE} data-live="checking">
  <span class="caption">
    <span class="dot" aria-hidden="true"></span>
    <span data-clock-caption>Lazaret demo live for</span>
  </span>
  <span class="row" aria-hidden="true">
    {
      groups.map((g, gi) => (
        <>
          {gi > 0 && <span class="colon">:</span>}
          <span class="group">
            <span class="flaps">
              {digits.slice(g.from, g.to).map((d) => (
                <span class="flap" data-flap>
                  <span class="half top"><span class="face">{d}</span></span>
                  <span class="half bottom"><span class="face">{d}</span></span>
                  <span class="leaf front"><span class="face">{d}</span></span>
                  <span class="leaf back"><span class="face">{d}</span></span>
                </span>
              ))}
            </span>
            <span class="unit">{g.label}</span>
          </span>
        </>
      ))
    }
  </span>
  <span class="visually-hidden" data-clock-words>{elapsedWords(atBuild)}</span>
</a>

<script>
  import { DEMO_ORIGIN } from "../lib/demo-client";
  import { elapsedSince, elapsedWords, flapDigits } from "../lib/flip-clock";

  for (const root of document.querySelectorAll<HTMLElement>("[data-clock]")) {
    const since = Number(root.dataset.since);
    const flaps = [...root.querySelectorAll<HTMLElement>("[data-flap]")];
    const words = root.querySelector<HTMLElement>("[data-clock-words]");
    const caption = root.querySelector<HTMLElement>("[data-clock-caption]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const shown = flaps.map((f) => f.querySelector(".top .face")?.textContent ?? "0");
    let timer: ReturnType<typeof setTimeout> | undefined;

    const set = (el: Element | null, v: string) => {
      if (el) el.textContent = v;
    };

    // One flap turns over: the old digit's top half falls away to reveal the new one,
    // then the new digit's bottom half lands over the old.
    const flip = (flap: HTMLElement, from: string, to: string, animate: boolean) => {
      set(flap.querySelector(".top .face"), to);
      set(flap.querySelector(".front .face"), from);
      set(flap.querySelector(".back .face"), to);
      if (!animate) {
        set(flap.querySelector(".bottom .face"), to);
        return;
      }
      set(flap.querySelector(".bottom .face"), from);
      flap.classList.remove("flipping");
      void flap.offsetWidth; // restart the animation
      flap.classList.add("flipping");
      setTimeout(() => set(flap.querySelector(".bottom .face"), to), 420);
    };

    const tick = (animate: boolean) => {
      const e = elapsedSince(since, Date.now());
      flapDigits(e).forEach((d, i) => {
        const flap = flaps[i];
        if (!flap || shown[i] === d) return;
        flip(flap, shown[i] ?? d, d, animate && !reduce.matches);
        shown[i] = d;
      });
      if (words) words.textContent = elapsedWords(e);
      root.title = `Live for ${elapsedWords(e)}`;
    };

    // Ticks land on the second boundary, and stop while the tab is hidden.
    const loop = () => {
      tick(true);
      timer = setTimeout(loop, 1000 - (Date.now() % 1000) + 5);
    };
    const start = () => {
      clearTimeout(timer);
      tick(false);
      timer = setTimeout(loop, 1000 - (Date.now() % 1000) + 5);
    };
    document.addEventListener("visibilitychange", () =>
      document.hidden ? clearTimeout(timer) : start(),
    );
    start();

    // Is the demo actually up? A clock that counts while it's down would be a fib.
    const ctrl = new AbortController();
    setTimeout(() => ctrl.abort(), 6_000);
    fetch(`${DEMO_ORIGIN}/__lazaret/status`, { signal: ctrl.signal, credentials: "omit" })
      .then((r) => {
        root.dataset.live = r.ok ? "up" : "down";
      })
      .catch(() => {
        root.dataset.live = "down";
      })
      .finally(() => {
        if (root.dataset.live === "down") {
          clearTimeout(timer);
          if (caption) caption.textContent = "Lazaret demo unreachable right now";
          root.removeAttribute("title");
        }
      });
  }
</script>

<style>
  .clock {
    display: inline-grid;
    justify-items: center;
    gap: 5px;
    text-decoration: none;
    color: var(--ink);
  }
  .caption {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-3);
    letter-spacing: 0.01em;
  }
  .clock.on-desk .caption {
    color: inherit;
    opacity: 0.62;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b9b2a8;
  }
  [data-live="up"] .dot {
    background: #1f9d55;
    box-shadow: 0 0 0 0 rgb(31 157 85 / 45%);
    animation: beacon 2.4s ease-out infinite;
  }
  [data-live="down"] .row {
    opacity: 0.38;
  }
  @keyframes beacon {
    70% {
      box-shadow: 0 0 0 6px rgb(31 157 85 / 0%);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(31 157 85 / 0%);
    }
  }
  .row {
    display: flex;
    align-items: flex-start;
    gap: 3px;
    transition: opacity 0.4s;
  }
  .group {
    display: grid;
    justify-items: center;
    gap: 3px;
  }
  .flaps {
    display: flex;
    gap: 2px;
    padding: 2px;
    border-radius: 4px;
    background: #2b2826;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 8%) inset,
      0 2px 4px -1px rgb(0 0 0 / 35%);
  }
  .colon {
    font-weight: 800;
    font-size: 0.95rem;
    line-height: 26px;
    color: inherit;
    opacity: 0.75;
  }
  .unit {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* One flap: two static halves, and two leaves that turn on the hinge between them. */
  .flap {
    --w: 15px;
    --h: 24px;
    position: relative;
    width: var(--w);
    height: var(--h);
    perspective: 80px;
    font: 700 1.05rem / var(--h) var(--figtree);
    font-variant-numeric: tabular-nums;
    color: #f4efe6;
  }
  .half,
  .leaf {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
    background: linear-gradient(#3a3633, #2f2c2a);
    border-radius: 2px;
    backface-visibility: hidden;
  }
  .top,
  .front {
    top: 0;
    transform-origin: 50% 100%;
    border-radius: 2px 2px 0 0;
  }
  .bottom,
  .back {
    bottom: 0;
    transform-origin: 50% 0;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(#2f2c2a, #282523);
  }
  .face {
    display: block;
    height: var(--h);
    text-align: center;
  }
  .bottom .face,
  .back .face {
    transform: translateY(-50%);
  }
  /* The hairline split across the middle of every flap. */
  .flap::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% - 0.5px);
    height: 1px;
    background: rgb(0 0 0 / 55%);
    z-index: 3;
  }
  .leaf {
    visibility: hidden;
    z-index: 2;
  }
  .flipping .front {
    visibility: visible;
    animation: fall 0.21s ease-in forwards;
  }
  .flipping .back {
    visibility: visible;
    transform: rotateX(90deg);
    animation: land 0.21s 0.21s ease-out forwards;
  }
  @keyframes fall {
    to {
      transform: rotateX(-90deg);
      filter: brightness(0.7);
    }
  }
  @keyframes land {
    from {
      transform: rotateX(90deg);
      filter: brightness(1.3);
    }
    to {
      transform: rotateX(0);
    }
  }
</style>
