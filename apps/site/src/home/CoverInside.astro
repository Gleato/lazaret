---
// The inside of the folder's front cover, which lies flat under the sheets once the
// folder is open. It does the footer's job in the folder's own terms: a routing slip
// (send this file on) and a business card tucked in the pocket (how to reach Ridge).
// The slip used to list three roles with checkboxes that were only drawn on. They read as
// broken, and live ones would all have done the same thing, so it is one real button
// now (src/lib/share.ts, the user's call, 2026-11-05).
import { EMAIL, GITHUB_PROFILE_URL, SITE_URL } from "./data/links";
---

<div class="inside">
  <div class="slip">
    <p class="slip-title">Routing slip</p>
    <p class="slip-note">Please pass along.</p>
    <button type="button" class="share" data-share data-url={SITE_URL}>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8.5 6.5 12 13 4" />
      </svg>
      <span data-share-label aria-live="polite">Share link</span>
    </button>
  </div>

  <div class="pocket-wrap">
    <div class="card">
      <p class="card-name">Ridge Gleaton</p>
      <p class="card-role">Software Engineer</p>
      <ul class="card-links">
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a href={GITHUB_PROFILE_URL}>github.com/Gleato</a></li>
      </ul>
    </div>
    <div class="pocket" aria-hidden="true"></div>
  </div>

  <p class="property">
    Property of Gleator. If found, please return to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
  </p>
</div>

<script>
  import { initShare } from "../lib/share";
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-share]")) initShare(b);
</script>

<style>
  .inside {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-rows: 1fr auto;
    gap: clamp(20px, 4vw, 48px);
    min-height: calc(var(--closed-h) - 14px - clamp(36px, 6.8vw, 80px));
    align-items: start;
  }
  .slip {
    align-self: start;
    max-width: 260px;
    padding: 16px 18px 14px;
    background: var(--paper);
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 6%),
      0 3px 5px -2px rgb(0 0 0 / 22%);
    transform: rotate(-1.4deg);
  }
  .slip-title {
    margin: 0 0 10px;
    font-weight: 800;
    font-size: 0.95rem;
  }
  .slip-note {
    margin: 0 0 12px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  /* Ruled like the form it sits on. */
  .share {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    font: inherit;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .share[data-state="copied"] {
    color: var(--paper);
    background: var(--ink);
  }
  /* Hover only where it exists: on touch it would stick after the tap. */
  @media (hover: hover) {
    .share:hover {
      color: var(--paper);
      background: var(--ink);
    }
  }
  .share svg {
    display: none;
    flex: none;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .share[data-state="copied"] svg {
    display: block;
  }

  /* The pocket: a die-cut flap glued to the cover, with the card tucked in behind it. */
  /* Card, then pocket pulled up over its last few millimetres: it's tucked in, but
     every line on it stays readable whatever the card's height. */
  .pocket-wrap {
    display: grid;
    justify-items: center;
    justify-self: end;
    width: min(100%, 420px);
    align-self: end;
  }
  .card {
    position: relative;
    width: min(88%, 340px);
    padding: 18px 20px;
    background: #fff;
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 7%),
      0 4px 10px -4px rgb(0 0 0 / 30%);
    transform: rotate(2.2deg);
  }
  .card p {
    margin: 0;
  }
  .card-name {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .card .card-role {
    color: var(--ink-2);
    font-size: 0.88rem;
    margin-bottom: 10px;
  }
  .card-links {
    list-style: none;
    margin: 0;
    padding: 10px 0 0;
    border-top: 1px solid #ece6dc;
    display: grid;
    gap: 3px;
    font-size: 0.88rem;
  }
  .card-links a {
    text-decoration: none;
    border-bottom: 1px solid #d8d0c4;
  }
  .card-links a:hover {
    border-bottom-color: currentColor;
  }
  .pocket {
    position: relative;
    width: 100%;
    height: 96px;
    margin-top: -30px;
    background: linear-gradient(var(--fold-mid), color-mix(in srgb, var(--fold-mid) 85%, var(--fold-deep)));
    border: 1px solid var(--fold-edge);
    border-radius: 4px 4px 12px 12px;
    clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%);
    box-shadow: 0 -2px 0 rgb(255 255 255 / 50%) inset;
    pointer-events: none;
  }
  .property {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink);
    font-size: 0.8rem;
  }
  .property a {
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .inside {
      grid-template-columns: 1fr;
    }
    .slip {
      justify-self: start;
    }
    .pocket-wrap {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
