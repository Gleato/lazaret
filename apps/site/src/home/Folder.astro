---
// The manila folder that holds the whole home page (the user's redesign, 2026-11-02).
//
// - Closed at first: the front cover lies over the sheets, the three divider tabs
//   showing above it. It nods open now and then, and says "Click to open".
// - Opening swings the cover down on its bottom hinge until it lies flat under the
//   back panel, inside up. From then on it stays open for the visit.
// - The fold between them is a real crease, plus one expansion score per page in the
//   open tab (a real folder is scored so it can fold flat around a thicker stack).
//   The crease rides the bottom of whichever sheet is in front.
// - The tabs never move sideways; the chosen divider comes to the front.
//
// State and keyboard rules: src/lib/folder.ts (unit-tested). Motion is WAAPI so it
// can be skipped outright under prefers-reduced-motion.
import type { TabId } from "../lib/folder";
import PREOPEN from "./folder-preopen.js?raw";

interface Props {
  pages: Record<TabId, number>;
}
const { pages } = Astro.props;

const tabs: { id: TabId; label: string; color: string; soft: string }[] = [
  { id: "profile", label: "Profile", color: "var(--blue)", soft: "var(--blue-soft)" },
  { id: "projects", label: "Projects", color: "var(--green)", soft: "var(--green-soft)" },
  { id: "experience", label: "Edu x Exp", color: "var(--red)", soft: "var(--red-soft)" },
];
const SCORES = 6;
---

<div class="folder" data-folder data-state="closed" data-active="profile" data-pages={JSON.stringify(pages)}>
  <div class="tabs" role="tablist" aria-label="Folder sections">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class="tab"
          id={`tab-${t.id}`}
          data-tab={t.id}
          aria-controls={`sheet-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          style={`--c: ${t.color}; --c-soft: ${t.soft}; --z: ${tabs.length - i}`}
        >
          <span class="tab-label">{t.label}</span>
        </button>
      ))
    }
  </div>

  <div class="shell" data-shell>
    <div class="body" data-body inert>
      <div class="divider-edge" aria-hidden="true"></div>
      <div class="sheets" data-sheets>
        {
          tabs.map((t, i) => (
            <section
              class="sheet"
              role="tabpanel"
              id={`sheet-${t.id}`}
              aria-labelledby={`tab-${t.id}`}
              data-sheet={t.id}
              hidden={i !== 0}
            >
              {t.id === "profile" && <slot name="profile" />}
              {t.id === "projects" && <slot name="projects" />}
              {t.id === "experience" && <slot name="experience" />}
            </section>
          ))
        }
      </div>
    </div>

    <div class="hinge" data-hinge data-scores={pages.profile} aria-hidden="true">
      <span class="crease"></span>
      {Array.from({ length: SCORES }, () => <span class="score" />)}
    </div>

    <div class="cover" data-cover>
      <button type="button" class="cover-front" data-open aria-label="Open the folder">
        <span class="label">
          <span class="label-name">Ridge Gleaton</span>
          <span class="label-line">Software engineer, Charleston, SC</span>
          <span class="label-file">File no. 001</span>
        </span>
        <span class="hint" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14"><path d="M10 15V5M5.5 9.5 10 5l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="hint-mouse">Click to open</span><span class="hint-touch">Tap to open</span>
        </span>
        <span class="front-scores" data-scores={pages.profile}>
          {Array.from({ length: SCORES }, () => <span class="score" />)}
        </span>
        <span class="shade"></span>
      </button>
      <div class="cover-inside" data-inside>
        <slot name="inside" />
        <span class="shade"></span>
      </div>
    </div>
  </div>
</div>

<!-- Pre-paint deep-link opener (folder-preopen.js), inlined verbatim; its CSP hash
     is computed from the same file in astro.config.mjs. -->
<script is:inline set:html={PREOPEN} />

<script>
  import { initFolder } from "./folder-ui";
  for (const root of document.querySelectorAll<HTMLElement>("[data-folder]")) initFolder(root);
</script>

<style>
  .folder {
    --closed-h: clamp(340px, 56vh, 520px);
    --radius: 20px;
    --stroke: 3px;
    --hinge-h: 22px;
    position: relative;
    margin-inline: clamp(0px, 3.5vw, 56px);
  }

  /* ── Tabs ─────────────────────────────────────────────────────────────────── */
  .tabs {
    position: relative;
    display: flex;
    padding-left: clamp(0px, 1vw, 6px);
    margin-bottom: calc(-1 * var(--stroke));
  }
  .tab {
    position: relative;
    z-index: var(--z);
    width: clamp(104px, 21%, 212px);
    height: 48px;
    margin-left: -14px;
    padding: 4px 14px 0;
    border: var(--stroke) solid var(--line);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background: var(--c-soft);
    color: var(--ink-2);
    font: 600 1rem / 1 var(--figtree);
    cursor: pointer;
    transform-origin: 50% 100%;
    transition:
      background-color 0.28s ease,
      color 0.28s ease,
      box-shadow 0.28s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .tab:first-child {
    margin-left: 0;
  }
  /* A sliver of shadow on the edge each tab tucks under, so the overlap reads as paper. */
  .tab::before {
    content: "";
    position: absolute;
    inset: 6px auto 0 -1px;
    width: 10px;
    border-radius: 12px 0 0 0;
    box-shadow: -4px 0 6px -4px rgb(40 25 0 / 30%);
    pointer-events: none;
  }
  .tab:first-child::before {
    display: none;
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab[aria-selected="true"] {
    z-index: 10;
    background: var(--c);
    color: #fff;
    font-style: italic;
    font-weight: 700;
    height: 52px;
    margin-top: -4px;
  }
  /* Closed, no divider is in front yet: every tab at rest. */
  .folder[data-state="closed"] .tab[aria-selected="true"] {
    z-index: var(--z);
    background: var(--c-soft);
    color: var(--ink-2);
    font-style: normal;
    font-weight: 600;
    height: 48px;
    margin-top: 0;
  }
  .tab-label {
    display: block;
    transform: translateY(1px);
  }
  .tab:focus-visible {
    outline-offset: -7px;
    outline-color: currentColor;
  }

  /* ── Back panel ───────────────────────────────────────────────────────────── */
  .shell {
    position: relative;
    perspective: 2400px;
    perspective-origin: 50% 0%;
  }
  .body {
    position: relative;
    z-index: 5;
    background: var(--manila);
    border: var(--stroke) solid var(--line);
    border-radius: 0 var(--radius) 0 0;
    border-bottom: 0;
    padding: clamp(18px, 3.4vw, 40px) clamp(12px, 5.6vw, 64px) clamp(26px, 4vw, 48px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 55%) inset;
  }
  .folder[data-state="closed"] .body,
  .folder[data-state="opening"] .body {
    height: var(--closed-h);
    overflow: hidden;
  }
  .folder[data-state="closed"] .body {
    border-bottom: var(--stroke) solid var(--line);
    border-radius: 0 var(--radius) var(--radius) var(--radius);
  }
  /* The top edge of the divider in front, peeking above the paper in its tab's colour. */
  .divider-edge {
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--edge, transparent);
    border-radius: 0 calc(var(--radius) - 4px) 0 0;
    transition: background-color 0.28s ease;
  }
  .folder[data-active="profile"]:not([data-state="closed"]) {
    --edge: var(--blue);
  }
  .folder[data-active="projects"]:not([data-state="closed"]) {
    --edge: var(--green);
  }
  .folder[data-active="experience"]:not([data-state="closed"]) {
    --edge: var(--red);
  }
  .sheets {
    position: relative;
  }
  .sheet:focus-visible {
    outline-offset: 6px;
  }

  /* ── The fold ─────────────────────────────────────────────────────────────── */
  .hinge {
    position: relative;
    display: none;
    height: var(--hinge-h);
    /* The board bends here: each side shades as it falls into the valley of the fold. */
    background: linear-gradient(
      var(--manila) 0%,
      color-mix(in srgb, var(--manila-2) 70%, var(--manila)) 30%,
      var(--manila-3) 49%,
      var(--manila-3) 51%,
      color-mix(in srgb, var(--manila-2) 70%, var(--manila)) 70%,
      var(--manila) 100%
    );
    border-inline: var(--stroke) solid var(--line);
  }
  .folder[data-state="opening"] .hinge,
  .folder[data-state="open"] .hinge {
    display: block;
  }
  /* The main crease: a valley (dark) with a lit lip above it. */
  .crease {
    position: absolute;
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
    background: rgb(110 78 22 / 48%);
    box-shadow:
      0 -1px 0 rgb(255 255 255 / 85%),
      0 1px 0 rgb(255 255 255 / 45%);
  }
  .score {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgb(120 88 30 / 22%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 70%);
    transition: opacity 0.35s ease;
  }
  .hinge .score:nth-of-type(1) {
    top: 3px;
  }
  .hinge .score:nth-of-type(2) {
    bottom: 3px;
  }
  .hinge .score:nth-of-type(3) {
    top: 0;
  }
  .hinge .score:nth-of-type(4) {
    bottom: 0;
  }
  .hinge .score:nth-of-type(5),
  .hinge .score:nth-of-type(6) {
    display: none;
  }
  /* One score per page: hide the ones the open tab doesn't need. */
  [data-scores="1"] .score:nth-of-type(n + 2),
  [data-scores="2"] .score:nth-of-type(n + 3),
  [data-scores="3"] .score:nth-of-type(n + 4),
  [data-scores="4"] .score:nth-of-type(n + 5),
  [data-scores="5"] .score:nth-of-type(n + 6) {
    opacity: 0;
  }

  /* ── Cover ────────────────────────────────────────────────────────────────── */
  .cover {
    position: relative;
    z-index: 6;
  }
  .folder[data-state="closed"] .cover,
  .folder[data-state="opening"] .cover {
    position: absolute;
    /* The front flap is cut a little shorter than the back, like a real folder. */
    top: 14px;
    left: 0;
    right: 0;
    height: calc(var(--closed-h) - 14px);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }
  .cover-front,
  .cover-inside {
    border: var(--stroke) solid var(--line);
  }
  .cover-front {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 20% 0%, rgb(255 255 255 / 35%), transparent 60%),
      var(--manila-2);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    backface-visibility: hidden;
    box-shadow: 0 -1px 0 rgb(255 255 255 / 50%) inset;
    font: inherit;
  }
  .cover-inside {
    /* Same size as the front: it's the other side of the same flap. */
    min-height: calc(var(--closed-h) - 14px);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--manila);
    padding: clamp(18px, 3.4vw, 40px) clamp(12px, 5.6vw, 64px);
    position: relative;
  }
  .folder[data-state="closed"] .cover-inside,
  .folder[data-state="opening"] .cover-inside {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    transform: rotateX(180deg);
    overflow: hidden;
  }
  .folder[data-state="open"] .cover-front {
    display: none;
  }
  .shade {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #3d2a05;
    opacity: 0;
    pointer-events: none;
  }

  /* The paper label on the front. */
  .label {
    position: absolute;
    top: clamp(28px, 7%, 56px);
    left: clamp(20px, 6%, 64px);
    display: grid;
    gap: 4px;
    min-width: min(72%, 320px);
    padding: 16px 20px 14px;
    background: var(--paper);
    border-radius: 3px;
    box-shadow:
      0 0 0 1px rgb(80 60 20 / 12%),
      0 2px 3px rgb(80 60 20 / 18%);
    transform: rotate(-0.6deg);
  }
  .label-name {
    font-weight: 800;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .label-line {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .label-file {
    margin-top: 6px;
    padding-top: 7px;
    border-top: 1px dashed rgb(80 60 20 / 30%);
    color: var(--ink-3);
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: calc(var(--hinge-h) + clamp(22px, 7%, 48px));
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px 9px 13px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--manila);
    font-weight: 600;
    font-size: 0.92rem;
    transform: translateX(-50%);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 60%);
    transition: transform 0.2s ease;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-touch {
      display: inline;
    }
    .hint-mouse {
      display: none;
    }
  }
  .front-scores {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--hinge-h);
  }
  .front-scores .score:nth-of-type(1) {
    top: 2px;
  }
  .front-scores .score:nth-of-type(2) {
    top: 6px;
  }
  .front-scores .score:nth-of-type(3) {
    top: 10px;
  }
  .front-scores .score:nth-of-type(4) {
    top: 14px;
  }
  .front-scores .score:nth-of-type(n + 5) {
    display: none;
  }

  /* The nudge: the cover lifts off the stack a little, now and then, until opened.
     Hover lifts it further, so it's plain that it's a lid. */
  @media (prefers-reduced-motion: no-preference) {
    .folder[data-state="closed"] .cover {
      animation: nudge 6s 1.6s ease-in-out infinite;
      transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1);
    }
    .folder[data-state="closed"] .cover:has(.cover-front:hover) {
      animation: none;
      transform: rotateX(-9deg);
    }
    .folder[data-state="closed"] .cover-front:hover .hint {
      transform: translateX(-50%) translateY(-2px);
    }
  }
  @keyframes nudge {
    0%,
    82%,
    100% {
      transform: rotateX(0);
    }
    88% {
      transform: rotateX(-7deg);
    }
    93% {
      transform: rotateX(-1deg);
    }
    96% {
      transform: rotateX(-3deg);
    }
  }
  .folder[data-state="closed"] .cover-front:focus-visible {
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .body,
    .cover-inside {
      padding-inline: 10px;
    }
    .folder {
      --closed-h: clamp(320px, 62vh, 480px);
      --radius: 14px;
      --stroke: 2.5px;
    }
    .tab {
      width: 37%;
      height: 42px;
      margin-left: -10px;
      font-size: 0.9rem;
      padding-inline: 8px;
      border-radius: 13px 13px 0 0;
    }
    .tab[aria-selected="true"] {
      height: 46px;
    }
    .folder[data-state="closed"] .tab[aria-selected="true"] {
      height: 42px;
    }
  }
</style>
