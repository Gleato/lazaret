---
// The folder that holds the whole home page (the user's redesign, 2026-11-02).
//
// - Closed at first: the front cover lies over the sheets, the three divider tabs
//   showing above it. It nods open now and then, and says "Click to open".
// - Opening swings the cover down on its bottom hinge while the back panel grows to fit
//   the sheet, so the cover lies flat below the sheet, inside up, in one motion. From
//   then on it stays open for the visit.
// - A little man on a ledge clipped to the cover (Bungee.astro) does the opening: he jumps on
//   a cord tied to it, and his weight pulls the cover down.
// - The fold between them is a real crease, plus one expansion score per page in the
//   open tab (a real folder is scored so it can fold flat around a thicker stack).
//   The crease rides the bottom of whichever sheet is in front.
// - The tabs never move sideways; the chosen divider comes to the front.
//
// State and keyboard rules: src/lib/folder.ts (unit-tested). Motion is WAAPI so it
// can be skipped outright under prefers-reduced-motion.
import type { TabId } from "../lib/folder";
import Bungee from "./Bungee.astro";
import PREOPEN from "./folder-preopen.js?raw";
// "Ridge Gleaton / Software engineer, Charleston, SC / File no. 001", written on the cover
// in marker. Baked paths, so to change the words see scripts/sharpie-cover.mjs. The button's
// aria-label names the control, as it did for the paper label this replaced.
import SHARPIE from "./parts/cover-sharpie.svg?raw";
import SHARPIE_TALL from "./parts/cover-sharpie-tall.svg?raw";

interface Props {
  pages: Record<TabId, number>;
}
const { pages } = Astro.props;

// One colour per tab, no tints of it (the user's colour pass, 2026-11-05). The whole folder
// takes the colour of the open tab, and the contents stay neutral, so the frame is the one
// place the site is loud.
const tabs: { id: TabId; label: string; fold: string }[] = [
  { id: "profile", label: "Profile", fold: "var(--fold-profile)" },
  { id: "projects", label: "Projects", fold: "var(--fold-projects)" },
  { id: "experience", label: "Edu x Exp", fold: "var(--fold-experience)" },
];
const SCORES = 6;
---

<div class="folder" data-folder data-state="closed" data-active="profile" data-pages={JSON.stringify(pages)}>
  <div class="tabs" role="tablist" aria-label="Folder sections">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class="tab"
          id={`tab-${t.id}`}
          data-tab={t.id}
          aria-controls={`sheet-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          style={`--tab: ${t.fold}; --z: ${tabs.length - i}`}
        >
          <span class="tab-label">{t.label}</span>
        </button>
      ))
    }
  </div>

  <div class="shell" data-shell>
    <div class="body" data-body inert>
      <div class="sheets" data-sheets>
        {
          tabs.map((t, i) => (
            <section
              class="sheet"
              role="tabpanel"
              id={`sheet-${t.id}`}
              aria-labelledby={`tab-${t.id}`}
              data-sheet={t.id}
              hidden={i !== 0}
            >
              {t.id === "profile" && <slot name="profile" />}
              {t.id === "projects" && <slot name="projects" />}
              {t.id === "experience" && <slot name="experience" />}
            </section>
          ))
        }
      </div>
    </div>

    <div class="hinge" data-hinge data-scores={pages.profile} aria-hidden="true">
      <span class="crease"></span>
      {Array.from({ length: SCORES }, () => <span class="score" />)}
    </div>

    <div class="cover" data-cover>
      <button type="button" class="cover-front" data-open aria-label="Open the folder">
        <span class="sharpie sharpie-wide" set:html={SHARPIE} />
        <span class="sharpie sharpie-tall" set:html={SHARPIE_TALL} />
        <span class="hint" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14"><path d="M10 15V5M5.5 9.5 10 5l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="hint-mouse">Click to open</span><span class="hint-touch">Tap to open</span>
        </span>
        <span class="front-scores" data-scores={pages.profile}>
          {Array.from({ length: SCORES }, () => <span class="score" />)}
        </span>
        <span class="shade"></span>
      </button>
      <div class="cover-inside" data-inside>
        <slot name="inside" />
        <span class="shade"></span>
      </div>
      <Bungee />
    </div>
  </div>
</div>

<!-- Pre-paint deep-link opener (folder-preopen.js), inlined verbatim; its CSP hash
     is computed from the same file in astro.config.mjs. -->
<script is:inline set:html={PREOPEN} />

<script>
  import { initFolder } from "./folder-ui";
  for (const root of document.querySelectorAll<HTMLElement>("[data-folder]")) initFolder(root);
</script>

<style>
  .folder {
    --closed-h: clamp(340px, 56vh, 520px);
    --radius: 20px;
    --stroke: 1px;
    /* The curve where the open tab flares into the folder. */
    --fillet: 12px;
    --hinge-h: 22px;
    /* The curve inside the outline: what anything laid against the top edge must follow. */
    --radius-in: calc(var(--radius) - var(--stroke));
    position: relative;
    /* Rests on the desk. drop-shadow, not box-shadow, so the tabs and the folder cast one
       silhouette. */
    filter: drop-shadow(0 22px 34px rgb(0 0 0 / 50%));
    margin-inline: clamp(0px, 3.5vw, 56px);
  }
  /* Room for the jumper below the open folder, so his bounce never changes the page height
     (his deepest point is about 110px down; .home-main adds 48 to 96px of its own). */
  .folder[data-state="opening"],
  .folder[data-state="open"] {
    margin-bottom: 76px;
  }

  /* ── Colour ─────────────────────────────────────────────────────────────────
     --fold is set on the body in home.css, so the header's network follows it too. */
  .folder {
    --fold-mid: color-mix(in srgb, var(--fold) 90%, var(--ink));
    --fold-deep: color-mix(in srgb, var(--fold) 78%, var(--ink));
    /* The edge of the card itself, a darker shade of its own colour. It was a charcoal
       outline, drawn for manila on a white desk; on the dark desk that read as a grey halo.
       50% black because it also has to read against the other tabs: at 66%, periwinkle's
       edge was as bright as the coral tab behind it and the line vanished. */
    --fold-edge: color-mix(in srgb, var(--fold) 50%, #000);
  }

  /* ── Tabs ─────────────────────────────────────────────────────────────────── */
  .tabs {
    position: relative;
    display: flex;
    /* Tabs sit on the flat run of the top edge, between the two rounded corners. Any
       closer and a tab overhangs the curve: on phones the last tab used to reach the
       right edge and left a gap under it, and the first sat a few px in from a square
       corner, which read as a stray notch. The fillet is added so the open tab's curve
       lands on that flat run too. */
    padding-inline: calc(var(--radius) + var(--fillet));
    margin-bottom: calc(-1 * var(--stroke));
  }
  .tab {
    position: relative;
    z-index: var(--z);
    width: clamp(104px, 21%, 212px);
    height: 48px;
    margin-left: -14px;
    /* Slim padding and no wrapping: "Edu x Exp" has to stay on one line at the narrowest
       tab, or the tab's fixed height clips it. */
    padding: 4px 8px 0;
    white-space: nowrap;
    --tab-edge: color-mix(in srgb, var(--tab) 50%, #000);
    border: var(--stroke) solid var(--tab-edge);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    /* A small step back toward the desk, so the open tab reads as in front. Any more and
       the colours turn muddy (marigold goes mustard). */
    background: color-mix(in srgb, var(--tab) 94%, var(--desk));
    color: var(--ink);
    font: 600 1rem / 1 var(--figtree);
    cursor: pointer;
    transform-origin: 50% 100%;
    transition:
      background-color 0.28s ease,
      color 0.28s ease,
      box-shadow 0.28s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .tab:first-child {
    margin-left: 0;
  }
  /* A sliver of shadow on the edge each tab tucks under, so the overlap reads as paper. */
  .tab::before {
    content: "";
    position: absolute;
    inset: 6px auto 0 -1px;
    width: 10px;
    border-radius: 12px 0 0 0;
    box-shadow: -4px 0 6px -4px rgb(0 0 0 / 30%);
    pointer-events: none;
  }
  .tab:first-child::before {
    display: none;
  }
  .tab:hover {
    color: var(--ink);
  }
  /* The same closed or open: the folder is this tab's colour either way, so the tab always
     reads as part of it, and nothing jumps when the cover opens. */
  .tab[aria-selected="true"] {
    z-index: 10;
    /* No bottom border, so the open tab and the folder read as one piece of card. */
    background: var(--tab);
    font-weight: 700;
    height: 52px;
    margin-top: -4px;
    /* The extra height goes on top, so the label stays level with the other tabs' labels. */
    padding-top: 8px;
  }
  /* The open tab flares into the folder: a concave curve each side, and its 1px edge bends
     with it into the folder's top edge, so the two read as one piece of card. Each corner
     is a circle punched out of the tab's colour, centred up and outside the tab, so whatever
     is behind (the desk, a back tab) shows through. The half-pixel steps are anti-aliasing. */
  .tab[aria-selected="true"]::after {
    --punch: transparent calc(var(--fillet) - 1.4px), var(--tab-edge) calc(var(--fillet) - 0.9px),
      var(--tab-edge) calc(var(--fillet) - 0.1px), var(--tab) calc(var(--fillet) + 0.4px);
    content: "";
    position: absolute;
    inset: auto calc(-1 * var(--fillet)) 0;
    height: var(--fillet);
    background:
      radial-gradient(circle at 0 0, var(--punch)) left bottom / var(--fillet) var(--fillet) no-repeat,
      radial-gradient(circle at 100% 0, var(--punch)) right bottom / var(--fillet) var(--fillet) no-repeat,
      linear-gradient(var(--tab), var(--tab)) center bottom / calc(100% - 2 * var(--fillet)) 100% no-repeat;
  }
  .tab-label {
    display: block;
    transform: translateY(1px);
  }
  .tab:focus-visible {
    outline-offset: -7px;
    outline-color: currentColor;
  }

  /* ── Back panel ───────────────────────────────────────────────────────────── */
  .shell {
    position: relative;
    /* perspective makes this its own stacking context, so .body's z-index only counts in
       here. This one sets the order against the tabs: above the back tabs, so the open
       folder's top edge and shadow run in front of them, and below the open tab (10). */
    z-index: 5;
    perspective: 2400px;
    perspective-origin: 50% 0%;
  }
  .body {
    position: relative;
    z-index: 5;
    background: var(--fold);
    border: var(--stroke) solid var(--fold-edge);
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 0;
    padding: clamp(18px, 3.4vw, 40px) clamp(12px, 5.6vw, 64px) clamp(26px, 4vw, 48px);
    /* The second shadow falls upward onto the tabs behind the folder, so they tuck under
       it. The open tab sits above the folder and stays clear of it. */
    box-shadow: 0 -3px 6px -1px rgb(0 0 0 / 24%);
  }
  .folder[data-state="closed"] .body,
  .folder[data-state="opening"] .body {
    height: var(--closed-h);
    overflow: hidden;
  }
  .folder[data-state="closed"] .body {
    border-bottom: var(--stroke) solid var(--fold-edge);
    border-radius: var(--radius);
  }
  .sheets {
    position: relative;
  }
  .sheet:focus-visible {
    outline-offset: 6px;
  }

  /* ── The fold ─────────────────────────────────────────────────────────────── */
  .hinge {
    position: relative;
    display: none;
    height: var(--hinge-h);
    /* The board bends here: each side shades as it falls into the valley of the fold. */
    background: linear-gradient(
      var(--fold) 0%,
      color-mix(in srgb, var(--fold-mid) 70%, var(--fold)) 30%,
      var(--fold-deep) 49%,
      var(--fold-deep) 51%,
      color-mix(in srgb, var(--fold-mid) 70%, var(--fold)) 70%,
      var(--fold) 100%
    );
    border-inline: var(--stroke) solid var(--fold-edge);
  }
  .folder[data-state="opening"] .hinge,
  .folder[data-state="open"] .hinge {
    display: block;
  }
  /* The main crease: a valley (dark) with a lit lip above it. */
  .crease {
    position: absolute;
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
    background: rgb(0 0 0 / 30%);
    box-shadow:
      0 -1px 0 rgb(255 255 255 / 28%),
      0 1px 0 rgb(255 255 255 / 16%);
  }
  .score {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgb(0 0 0 / 14%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 22%);
    transition: opacity 0.35s ease;
  }
  .hinge .score:nth-of-type(1) {
    top: 3px;
  }
  .hinge .score:nth-of-type(2) {
    bottom: 3px;
  }
  .hinge .score:nth-of-type(3) {
    top: 0;
  }
  .hinge .score:nth-of-type(4) {
    bottom: 0;
  }
  .hinge .score:nth-of-type(5),
  .hinge .score:nth-of-type(6) {
    display: none;
  }
  /* One score per page: hide the ones the open tab doesn't need. */
  [data-scores="1"] .score:nth-of-type(n + 2),
  [data-scores="2"] .score:nth-of-type(n + 3),
  [data-scores="3"] .score:nth-of-type(n + 4),
  [data-scores="4"] .score:nth-of-type(n + 5),
  [data-scores="5"] .score:nth-of-type(n + 6) {
    opacity: 0;
  }

  /* ── Cover ────────────────────────────────────────────────────────────────── */
  .cover {
    position: relative;
    z-index: 6;
  }
  .folder[data-state="closed"] .cover,
  .folder[data-state="opening"] .cover {
    position: absolute;
    /* The front flap is cut a little shorter than the back, like a real folder. */
    top: 14px;
    left: 0;
    right: 0;
    height: calc(var(--closed-h) - 14px);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }
  .cover-front,
  .cover-inside {
    border: var(--stroke) solid var(--fold-edge);
  }
  .cover-front {
    /* The shade inside the folder, cast by the cover rather than painted on the back panel:
       a shadow follows the cover's rounded corners and moves with it when it tilts, which
       a fixed gradient did neither of. Reach stays under the 14px strip, so it clears the tabs. */
    box-shadow:
      0 -1px 3px rgb(0 0 0 / 24%),
      0 -3px 9px rgb(0 0 0 / 26%);
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border-radius: var(--radius);
    /* Flat: a white sheen suited manila but turned the saturated card chalky. */
    background: var(--fold);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    backface-visibility: hidden;
    font: inherit;
  }
  .cover-inside {
    /* Same size as the front: it's the other side of the same flap. */
    min-height: calc(var(--closed-h) - 14px);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--fold);
    padding: clamp(18px, 3.4vw, 40px) clamp(12px, 5.6vw, 64px);
    position: relative;
  }
  .folder[data-state="closed"] .cover-inside,
  .folder[data-state="opening"] .cover-inside {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    transform: rotateX(180deg);
    overflow: hidden;
  }
  .folder[data-state="open"] .cover-front {
    display: none;
  }
  .shade {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  /* Written straight on the card in marker (the user's call, 2026-11-05: no paper label).
     Same --ink as the tab labels and the hint: ink is the only colour on the frame besides
     the card's own, so a warmer "soaked in" mix read as a second, brownish black. */
  .sharpie {
    position: absolute;
    top: clamp(24px, 9%, 60px);
    left: clamp(18px, 6.5%, 72px);
    width: min(64%, 680px);
    color: var(--ink);
    pointer-events: none;
  }
  .sharpie :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sharpie-tall {
    display: none;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: calc(var(--hinge-h) + clamp(22px, 7%, 48px));
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px 9px 13px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
    transform: translateX(-50%);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 60%);
    transition: transform 0.2s ease;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-touch {
      display: inline;
    }
    .hint-mouse {
      display: none;
    }
  }
  .front-scores {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--hinge-h);
  }
  .front-scores .score:nth-of-type(1) {
    top: 2px;
  }
  .front-scores .score:nth-of-type(2) {
    top: 6px;
  }
  .front-scores .score:nth-of-type(3) {
    top: 10px;
  }
  .front-scores .score:nth-of-type(4) {
    top: 14px;
  }
  .front-scores .score:nth-of-type(n + 5) {
    display: none;
  }

  /* The nudge: the cover lifts off the stack a little, now and then, until opened.
     Hover lifts it further, so it's plain that it's a lid. */
  @media (prefers-reduced-motion: no-preference) {
    .folder[data-state="closed"] .cover {
      animation: nudge 6s 1.6s ease-in-out infinite;
      transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1);
    }
    .folder[data-state="closed"] .cover:has(.cover-front:hover) {
      animation: none;
      transform: rotateX(-9deg);
    }
    .folder[data-state="closed"] .cover-front:hover .hint {
      transform: translateX(-50%) translateY(-2px);
    }
  }
  @keyframes nudge {
    0%,
    82%,
    100% {
      transform: rotateX(0);
    }
    88% {
      transform: rotateX(-7deg);
    }
    93% {
      transform: rotateX(-1deg);
    }
    96% {
      transform: rotateX(-3deg);
    }
  }
  .folder[data-state="closed"] .cover-front:focus-visible {
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .body,
    .cover-inside {
      padding-inline: 10px;
    }
    .folder {
      --closed-h: clamp(320px, 62vh, 480px);
      --radius: 14px;
      --fillet: 8px;
    }
    .tab {
      width: 37%;
      height: 42px;
      margin-left: -10px;
      font-size: 0.9rem;
      padding-inline: 8px;
      border-radius: 13px 13px 0 0;
    }
    .tab[aria-selected="true"] {
      height: 46px;
    }
  }
  /* A portrait cover gets the stacked writing, sized so it clears the hint on short phones.
     Landscape phones keep the long lines: there the cover is wide again. */
  @media (max-width: 640px) and (min-height: 480px) {
    .sharpie-wide {
      display: none;
    }
    .sharpie-tall {
      display: block;
      /* Height left above the hint, turned into a width by the drawing's 800:880 shape. */
      top: clamp(14px, 5%, 40px);
      width: min(80%, 320px, calc((var(--closed-h) - 170px) / 1.1));
    }
  }
</style>
