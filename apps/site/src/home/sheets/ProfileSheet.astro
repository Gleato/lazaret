---
// The Profile sheet (board 1): the name, the rule under it, the user's intro in their
// own words, and the photo strip. A made-up reporter's profile used to dress this page
// (masthead, byline, stamp, polaroid, margin notes); the user cut it on 2026-11-05 in
// favour of a plain intro, so keep this page in Ridge's own voice.
import { INTRO, PHOTOS } from "../data/profile";
import PhotoStrip from "../parts/PhotoStrip.astro";
---

<article class="paper profile">
  <h2 class="name">Ridge Gleaton</h2>
  <span class="rule" aria-hidden="true"></span>
  <p class="intro">{INTRO}</p>

  <PhotoStrip photos={PHOTOS} />
</article>

<style>
  .profile {
    color: var(--ink);
  }

  .name {
    margin: 0;
    font-size: clamp(2.3rem, 5.4vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  /* The board's heavy rule under the name, with slightly rounded, inked ends. */
  .rule {
    display: block;
    width: min(100%, 470px);
    height: 5px;
    margin: 16px 0 22px;
    border-radius: 3px;
    background: var(--ink);
  }

  .intro {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.7vw, 1.16rem);
    line-height: 1.62;
    font-weight: 500;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .intro {
      font-size: 1rem;
    }
  }
</style>
