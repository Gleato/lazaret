---
// The Edu x Exp divider (board 3): the timeline, the resume as a PDF download, and a
// "worked with" wall of the logos the user supplied (each the organisation's own file).
// The full resume used to be set on this page too; the user cut it on 2026-11-05 because
// the timeline is quicker to read, so the PDF is now the only copy on the site.
import { RESUME_PDF } from "../data/career";
import LogoWall from "../parts/LogoWall.astro";
import Timeline from "../parts/Timeline.astro";
---

<div class="paper exp">
  <Timeline />

  <p class="resume-link">
    <a class="download" href={RESUME_PDF} download="Ridge-Gleaton-Resume.pdf">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12"></path></svg>
      Download resume
    </a>
  </p>

  <LogoWall />
</div>

<style>
  .exp {
    border: 1px solid #cfc8bd;
  }
  .resume-link {
    margin: clamp(26px, 4vw, 36px) 0 0;
    text-align: center;
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px 9px 13px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .download:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .download svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
