---
// gleator.com (M9): Ridge's portfolio, as a manila folder with three dividers.
// The boards it follows are in tasks/todo.md (M9); the long Lazaret write-up stays at
// /projects/lazaret and the Projects sheet links to it.
import BaseLayout from "../layouts/BaseLayout.astro";
import CoverInside from "./CoverInside.astro";
import Folder from "./Folder.astro";
import "./home.css";
import { PROJECT_PAGES } from "./data/projects";
import SiteHeader from "./SiteHeader.astro";
import ExperienceSheet from "./sheets/ExperienceSheet.astro";
import ProfileSheet from "./sheets/ProfileSheet.astro";
import ProjectsSheet from "./sheets/ProjectsSheet.astro";
---

<BaseLayout
  title="Ridge Gleaton, software engineer"
  description="Ridge Gleaton's portfolio: a software engineer who builds production claims systems for the VA and Lazaret, an open-source AI write-quarantine for web APIs."
  footer={false}
  bodyClass="home"
  themeColor={{ light: "#ffffff", dark: "#1b1a19" }}
>
  <a class="skip" href="#folder">Skip to the folder</a>
  <div class="home-main">
    <SiteHeader />
    <main id="folder">
      <h1 class="visually-hidden">Ridge Gleaton: portfolio</h1>
      <Folder pages={{ profile: 1, projects: PROJECT_PAGES, experience: 1 }}>
        <ProfileSheet slot="profile" />
        <ProjectsSheet slot="projects" />
        <ExperienceSheet slot="experience" />
        <CoverInside slot="inside" />
      </Folder>
    </main>
  </div>
</BaseLayout>
