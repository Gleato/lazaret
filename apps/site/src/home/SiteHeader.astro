---
// The home page header from the boards: the Gleator wordmark, the uptime clock in
// the middle, and the official npm and GitHub lockups (the user's own logo files),
// which link to the published package and the repo.
import { Image } from "astro:assets";
import github from "../assets/logos/github-lockup.svg";
import npm from "../assets/logos/npm.png";
import { GITHUB_URL, NPM_URL } from "./data/links";
import FlipClock from "./FlipClock.astro";
---

<header class="site-head">
  <a class="wordmark on-desk" href="/" aria-label="Gleator, home">Gleator</a>
  <div class="clock-slot"><FlipClock /></div>
  <nav class="links" aria-label="Lazaret">
    <a href={NPM_URL} class="brand-link" aria-label="@gleator/lazaret on npm">
      <Image src={npm} alt="" height={20} class="logo npm" loading="eager" />
    </a>
    <a href={GITHUB_URL} class="brand-link" aria-label="Lazaret on GitHub">
      <Image src={github} alt="" height={24} class="logo gh" loading="eager" />
    </a>
  </nav>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: clamp(20px, 3.4vw, 44px) clamp(24px, 3.6vw, 48px);
  }
  .wordmark {
    justify-self: start;
    font: 800 clamp(2.6rem, 6.2vw, 5.4rem) / 0.9 var(--figtree);
    letter-spacing: -0.035em;
    color: var(--ink);
    text-decoration: none;
    /* Optical alignment: the G's bowl overshoots the folder's left edge otherwise. */
    margin-left: -0.04em;
  }
  .clock-slot {
    justify-self: center;
  }
  .links {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 36px);
  }
  .brand-link {
    display: inline-flex;
    padding: 6px 2px;
    border-radius: 4px;
    transition: opacity 0.15s;
  }
  .brand-link:hover {
    opacity: 0.65;
  }
  .logo {
    display: block;
    width: auto;
  }
  .npm {
    height: 17px;
  }
  .gh {
    height: 22px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .logo {
      filter: invert(1);
    }
  }
  :root[data-theme="dark"] .logo {
    filter: invert(1);
  }

  /* Phones: wordmark and links share the top row, the clock sits under them. */
  @media (max-width: 700px) {
    .site-head {
      grid-template-columns: 1fr auto;
      row-gap: 14px;
    }
    .clock-slot {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .npm {
      height: 14px;
    }
    .gh {
      height: 19px;
    }
  }
</style>
