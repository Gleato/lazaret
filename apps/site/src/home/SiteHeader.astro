---
// The home page header: the Gleator wordmark, the neural network animation in the middle,
// and the official npm and GitHub lockups (the user's own logo files, inverted for the
// charcoal desk). GitHub goes to Ridge's profile, npm to the published package. LinkedIn
// isn't here because the user doesn't use it.
import { Image } from "astro:assets";
import github from "../assets/logos/github-lockup.svg";
import npm from "../assets/logos/npm.png";
import { GITHUB_PROFILE_URL, NPM_URL } from "./data/links";
import NeuralFlow from "./NeuralFlow.astro";
---

<header class="site-head">
  <a class="wordmark on-desk" href="/" aria-label="Gleator, home">Gleator</a>
  <div class="net-slot"><NeuralFlow /></div>
  <nav class="links on-desk" aria-label="Elsewhere">
    <a href={NPM_URL} class="brand-link" aria-label="@gleator/lazaret on npm">
      <Image src={npm} alt="" height={17} densities={[1, 2, 3]} class="logo npm" loading="eager" />
    </a>
    <a href={GITHUB_PROFILE_URL} class="brand-link" aria-label="Ridge Gleaton on GitHub">
      <Image src={github} alt="" height={24} class="logo gh" loading="eager" />
    </a>
  </nav>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: clamp(20px, 3.4vw, 44px) clamp(24px, 3.6vw, 48px);
  }
  .wordmark {
    justify-self: start;
    font: 800 clamp(2.6rem, 6.2vw, 5.4rem) / 0.9 var(--figtree);
    letter-spacing: -0.035em;
    text-decoration: none;
    /* Optical alignment: the G's bowl overshoots the folder's left edge otherwise. */
    margin-left: -0.04em;
  }
  .net-slot {
    justify-self: center;
    min-width: 0;
  }
  .links {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 36px);
  }
  .brand-link {
    display: inline-flex;
    padding: 6px 2px;
    border-radius: 4px;
    transition: opacity 0.15s;
  }
  .brand-link:hover {
    opacity: 0.65;
  }
  .logo {
    display: block;
    width: auto;
    /* Both files are dark artwork, and the desk is always charcoal. brightness(0) first
       because npm's is #231f20, not black, so inverting alone left it grey beside GitHub.
       Invert gives pure white, cold next to the wordmark; the last two land on --on-desk. */
    filter: brightness(0) invert(1) brightness(0.9) sepia(0.15);
  }
  .npm {
    height: 17px;
  }
  .gh {
    height: 22px;
  }

  /* Phones: wordmark and links share the top row, the network sits under them. */
  @media (max-width: 700px) {
    .site-head {
      grid-template-columns: 1fr auto;
      row-gap: 14px;
    }
    .net-slot {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .npm {
      height: 14px;
    }
    .gh {
      height: 19px;
    }
  }
</style>
