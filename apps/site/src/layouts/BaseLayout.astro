---
// The shell every gleator.com page shares: head, fonts, tokens, footer. Projects get
// their own layout on top (ProjectLayout), so adding /projects/<name> later, or an
// index homepage, reuses this without a redesign.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The folder home draws its own contact card inside the folder, so it opts out (M9). */
  footer?: boolean;
  bodyClass?: string;
  /** Browser chrome colour; the folder home sits on a white desk, the project page on lagoon paper. */
  themeColor?: { light: string; dark: string };
  /** Pages search engines shouldn't index (the 404): no canonical, robots noindex. */
  noindex?: boolean;
}
const {
  title,
  description,
  footer = true,
  bodyClass,
  themeColor = { light: "#eceee6", dark: "#0f1b1f" },
  noindex = false,
} = Astro.props;
// Pages build as files (astro.config: build.format "file"), so the path can end in
// ".html"; the canonical URL is the clean one the site actually serves.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Figtree is self-hosted (styles/global.css); preload the two weights above the fold. -->
    <link rel="preload" href="/fonts/figtree-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-extrabold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={bodyClass}>
    <slot />
    {footer && (
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Built by <a href="https://github.com/Gleato">Gleato</a>. Lazaret's code, evals and
          this site are open source on <a href="https://github.com/Gleato/lazaret">GitHub</a>.
        </p>
      </div>
    </footer>
    )}
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 2rem 3rem;
    color: var(--ink-2);
    font-family: var(--sans);
  }
  .site-footer p {
    margin: 0;
  }
</style>
