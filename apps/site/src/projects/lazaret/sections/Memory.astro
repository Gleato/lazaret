---
// The Memory: what learning buys, as a learning curve from the campaign replay eval
// (M7.1, built at build time from evals/results/campaign-*.json; it replaced the
// two-phase cold/warm table, which could only ever say "nothing learned"), and the
// rules the live demo has learned so far (fetched from the demo's /__lazaret/memory).
import CurveChart from "../components/CurveChart.astro";
import { curve } from "../data/memory";
---

<section class="section" id="memory" aria-labelledby="memory-title">
  <div class="wrap">
    <header>
      <h2 id="memory-title">It learns from what it catches</h2>
      <p>
        Every verdict is archived. After a batch with drops, a model proposes a deterministic rule.
        The rule is tested against past traffic, watched on live traffic, and only then allowed to
        flag or block at the gate, where it costs nothing and takes microseconds. Where a rule and
        the reviewer disagree, a person decides.
      </p>
    </header>

    <h3>Under a sustained attack, the gate takes over</h3>
    {
      curve ? (
        <div class="curve-block">
          <p class="sans hint">{curve.summary}</p>
          <div class="charts">
            {curve.charts.map((c) => (
              <CurveChart chart={c} />
            ))}
          </div>
          <div class="tip sans" id="curve-tip" role="status" hidden>
            <strong class="tip-value" />
            <span class="tip-label" />
          </div>
          <details class="numbers">
            <summary class="sans">Show the numbers, window by window</summary>
            <div class="scroll" tabindex="0" role="region" aria-label="Learning curve numbers">
              <table class="lining sans">
                <thead>
                  <tr>
                    {curve.table.head.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {curve.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <ul class="caveats sans">
            {curve.caveats.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
          <p class="sans source">{curve.source}</p>
        </div>
      ) : (
        <p class="sans hint">The campaign replay eval hasn't been published yet.</p>
      )
    }

    <div class="live-rules">
      <h3>Rules the demo has learned</h3>
      <p class="sans hint" id="rules-summary">Loading the live Memory…</p>
      <ol class="rules" id="rules"></ol>
    </div>
  </div>
</section>

<script>
  import { DEMO_ORIGIN } from "../../../lib/demo-client";
  import { h } from "../../../lib/dom";

  interface Rule {
    id: string;
    status: string;
    category: string;
    description: string;
    support: number;
    cleanSamples: number;
    liveTruePositives: number;
    liveFalsePositives: number;
  }

  const STATUS: Record<string, string> = {
    pending: "Waiting for evidence: more matching drops, clean traffic, or a person's label",
    shadow: "Watching live traffic, no effect yet",
    flag: "Adds risk at the gate",
    block: "Blocks at the gate",
    rejected: "Rejected: it matched traffic known to be clean",
    retired: "Retired",
  };
  const ORDER = ["block", "flag", "shadow", "pending", "retired", "rejected"];

  async function load(): Promise<void> {
    const summary = document.getElementById("rules-summary") as HTMLElement;
    const list = document.getElementById("rules") as HTMLElement;
    try {
      const res = await fetch(`${DEMO_ORIGIN}/__lazaret/memory`);
      const body = (await res.json()) as {
        enabled: boolean;
        rules: Rule[];
        stats: { archived: Record<string, number> } | null;
      };
      const archived = Object.values(body.stats?.archived ?? {}).reduce((a, b) => a + b, 0);
      const rules = body.rules.sort((a, b) => ORDER.indexOf(a.status) - ORDER.indexOf(b.status));
      summary.textContent = rules.length
        ? `${rules.length} ${rules.length === 1 ? "rule" : "rules"} from ${archived} archived verdicts. The Memory carries over when the demo resets each hour.`
        : `Nothing learned yet from ${archived} archived verdicts. Rules need a few drops of the same kind before one is proposed.`;
      list.replaceChildren(
        ...rules.map((r) =>
          h(
            "li",
            {},
            h("span", { class: `st ${r.status}` }, STATUS[r.status] ?? r.status),
            h("span", { class: "desc" }, r.description),
            h(
              "span",
              { class: "meta" },
              `${r.category}. Matched ${r.support} past drops, tested against ${r.cleanSamples} clean writes. Live: ${r.liveTruePositives} right, ${r.liveFalsePositives} wrong.`,
            ),
          ),
        ),
      );
    } catch {
      summary.textContent = "The live Memory can't be reached right now.";
    }
  }
  void load();

  // One shared tooltip for the learning-curve charts: value first, then the window.
  // Text only (textContent), and every value it shows is also in the table.
  const tip = document.getElementById("curve-tip");
  if (tip) {
    const value = tip.querySelector(".tip-value") as HTMLElement;
    const label = tip.querySelector(".tip-label") as HTMLElement;
    const show = (el: Element) => {
      const box = (tip.parentElement as HTMLElement).getBoundingClientRect();
      const r = el.getBoundingClientRect();
      value.textContent = el.getAttribute("data-tip-value");
      label.textContent = el.getAttribute("data-tip-label");
      tip.hidden = false;
      const left = Math.min(
        Math.max(r.left + r.width / 2 - box.left - tip.offsetWidth / 2, 0),
        box.width - tip.offsetWidth,
      );
      tip.style.left = `${left}px`;
      tip.style.top = `${r.top - box.top - tip.offsetHeight - 6}px`;
    };
    const hide = () => {
      tip.hidden = true;
    };
    for (const el of document.querySelectorAll("#memory .pt")) {
      el.addEventListener("pointerenter", () => show(el));
      el.addEventListener("pointerleave", hide);
      el.addEventListener("focus", () => show(el));
      el.addEventListener("blur", hide);
    }
  }
</script>

<style>
  h3 {
    margin-bottom: 0.4rem;
  }
  .hint,
  .source {
    color: var(--ink-2);
    font-size: var(--t-1);
  }
  .curve-block {
    position: relative;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .charts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 1rem 0 0.75rem;
  }
  .tip {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    display: grid;
    padding: 0.3rem 0.55rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.12);
    font-size: var(--t-1);
    line-height: 1.3;
    white-space: nowrap;
  }
  .tip[hidden] {
    display: none;
  }
  .tip-value {
    font-size: var(--t0);
    color: var(--ink);
  }
  .tip-label {
    color: var(--ink-2);
  }
  .numbers {
    margin: 0.5rem 0 0.75rem;
  }
  .numbers summary {
    cursor: pointer;
    font-size: var(--t-1);
    color: var(--lagoon);
  }
  .scroll {
    overflow-x: auto;
    margin-top: 0.5rem;
  }
  table {
    width: 100%;
    /* Scrolls inside .scroll on narrow screens rather than wrapping every cell. */
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--t-1);
    font-variant-numeric: lining-nums tabular-nums;
  }
  th,
  td {
    text-align: left;
    padding: 0.35rem 0.75rem 0.35rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  thead th {
    font-weight: 700;
    color: var(--ink-2);
  }
  tbody th {
    font-weight: 400;
  }
  .caveats {
    margin: 0 0 0.6rem;
    padding-left: 1.1rem;
    max-width: var(--measure);
    font-size: var(--t-1);
    color: var(--ink-2);
  }
  .caveats li + li {
    margin-top: 0.25rem;
  }
  .live-rules {
    max-width: 48rem;
  }
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .rules :global(li) {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .rules :global(.st) {
    font: 700 var(--t-1) / 1.2 var(--sans);
    color: var(--lagoon);
  }
  .rules :global(.st.block) {
    color: var(--b);
  }
  .rules :global(.st.retired),
  .rules :global(.st.rejected) {
    color: var(--ink-3);
  }
  .rules :global(.meta) {
    color: var(--ink-2);
    font: 400 var(--t-1) / 1.4 var(--sans);
  }
  @media (max-width: 860px) {
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
