{
  "name": "@gleator/site",
  "private": true,
  "version": "0.0.0",
  "description": "gleator.com: the Lazaret project page and its live demo UI.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:prod": "PUBLIC_DEMO_ORIGIN=https://demo.gleator.com PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFvvMgNi15gwPGyt astro build",
    "deploy": "npm run build:prod && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.3"
  },
  "devDependencies": {
    "@fontsource/covered-by-your-grace": "^5.3.0",
    "@gleator/lazaret": "*",
    "@types/node": "^22.15.17",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
