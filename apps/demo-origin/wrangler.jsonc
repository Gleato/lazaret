// Tidewater Support, the demo origin. It has no public route on purpose
// (workers_dev: false): the only way in is the service binding from the Lazaret
// deployment in apps/demo-lazaret, and every request must carry Lazaret's HMAC
// signature anyway. Static UI files are served from ./public.
{
  "name": "tidewater-origin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "run_worker_first": ["/api/*", "/admin/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidewater",
      "database_id": "6319ebd4-1ffa-47c3-904b-c4017fb3ab46",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set by you, never committed; `-c apps/demo-origin/wrangler.jsonc`):
  //   LAZARET_SIGNING_SECRET   shared with demo-lazaret (≥ 32 chars)
  //   ANTHROPIC_API_KEY        Tidewater's own support agent (POST /api/agent/run)
}
